#*****************************************************************************
# meson.build (midiname/src)
#-----------------------------------------------------------------------------
##
# \file        src/meson.build
# \library     midiname
# \author      Chris Ahlstrom
# \date        2026-02-21
# \updates     2026-03-22
# \license     $XPC_SUITE_GPL_LICENSE$
#
#  This file is part of the "midiname" library. See the top-level meson.build
#  file for license information.
#
#  Here we locate the library source-code files.  They reside in:
#
#     -  src. The main include directory for non-namespace code.
#     -  src/cfg. Contains code for parsing command lines.
#
#-----------------------------------------------------------------------------

libmidiname_sources += files(
   'midiname.cpp',
   'midi/nam/midnam_entities.cpp',
   'midi/nam/midnampack.cpp',
   'midi/nam/midipatchmanager.cpp',
   'midi/pack/patchbank.cpp'
   )

